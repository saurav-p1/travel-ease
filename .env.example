# Copy this file to .env and fill in real values. Never commit .env itself.
DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-string
SITE_DOMAIN=127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional. Free, no credit card: https://carto.com/basemaps/apikey/
# Without this, the live location map on destination/restaurant pages
# still works but shows a large "API KEY REQUIRED" watermark on every
# tile (CARTO started requiring this for their free raster tiles in
# Aug 2026). Get a key and paste it here to remove the watermark.
CARTO_API_KEY=

# Optional. Without this, password-reset/allauth emails just print to the
# server log instead of actually being delivered -- fine for local dev,
# but real users in production won't receive them until this is set.
# Any real SMTP provider works (Gmail with an App Password, SendGrid,
# Mailgun, etc.) -- example values for Gmail shown below.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TravelEase <noreply@travelease.example>

# Contact URL or email, used to build a policy-compliant User-Agent for the
# OpenStreetMap/Overpass, Wikidata and Wikipedia requests the data commands
# make. Both services require clients to identify themselves; since 2026
# Wikimedia sorts requests without a contact into a restrictive rate-limit
# tier, which is what produced the "HTTP 429 from Wikipedia" run. Required
# by build_open_dataset and backfill_images.
TRAVELEASE_CONTACT=https://github.com/<your-username>/travelease
